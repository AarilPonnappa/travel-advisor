# Copy this file to .env (next to pom.xml) and fill in your own values. .env is git-ignored.
# Anything left blank falls back to built-in estimates, except the database, which is required.

# database (Postgres). A Render-style postgres://user:pass@host/db url also works here.
DB_URL=jdbc:postgresql://localhost:5432/jarvis
DB_USERNAME=jarvis
DB_PASSWORD=

APP_CURRENCY=USD

# driving routes, travel-time matrix, city lookup (free key)
OPENROUTESERVICE_API_KEY=
# activity places and restaurants (free key)
GEOAPIFY_API_KEY=
# public transport, no key, but say how to contact you
TRANSITOUS_USER_AGENT=jarvis-travel-advisor/1.0 (mailto:you@example.com)

# flights and hotels: SerpApi first, then SearchApi.io, then Duffel for flights
SERPAPI_API_KEY=
SEARCHAPI_API_KEY=
DUFFEL_ACCESS_TOKEN=

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Gemini: the planner key also powers the road-trip planner (preferences + route suggestions)
GEMINI_PLANNER_API_KEY=
GEMINI_CHAT_API_KEY=
